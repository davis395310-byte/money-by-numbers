# MBN stack check — runs every 15 minutes on GitHub Actions.
#
# Free forever: scheduled workflows on public repos cost nothing, and the
# runner is external to Render/Vercel, so it keeps working when they don't.
# No secrets: the checker uses only public endpoints; failures are filed
# as GitHub issues (label: monitoring-alert), which a watcher forwards
# to Richard.
#
# Manual run: Actions tab -> "MBN stack check" -> Run workflow.

name: MBN stack check

on:
  schedule:
    - cron: "*/15 * * * *"
  workflow_dispatch:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Run stack check
        id: check
        run: python3 ops/monitor/check_stack.py

      - name: File alert issue on failure
        if: failure()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          RUN_URL="${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
          BODY="The scheduled MBN stack check failed at $(date -u +%FT%TZ). See the run for details: ${RUN_URL}"
          EXISTING=$(gh issue list --label monitoring-alert --state open --json number --jq '.[0].number')
          if [ -z "$EXISTING" ]; then
            gh issue create \
              --title "[monitoring] MBN stack check failing" \
              --label monitoring-alert \
              --body "$BODY"
          else
            gh issue comment "$EXISTING" --body "Still failing at $(date -u +%FT%TZ). $RUN_URL"
          fi

      - name: Close alert issues on recovery
        if: success()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          for n in $(gh issue list --label monitoring-alert --state open --json number --jq '.[].number'); do
            gh issue close "$n" --comment "Stack check is green again — closing automatically."
          done
