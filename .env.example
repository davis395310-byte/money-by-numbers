# MONEY BY NUMBERS — environment template
# Copy to .env and fill in. NEVER commit .env. No secret values below —
# every value is intentionally empty.
#
# Legend:
#   [REQUIRED prod]  must be set for production
#   [REQUIRED auth]  must be set for Google sign-in to work
#   [REQUIRED odds]  must be set for live odds
#   [REQUIRED pay]   must be set for Stripe subscriptions (phase 9)
#   [optional]       not needed unless the feature is enabled

# ---------------------------------------------------------------- DATABASE
# [REQUIRED prod] MongoDB connection string.
# Dev: optional — docker-compose provides a local mongo:7 automatically.
MONGODB_URI=

# -------------------------------------------------------------------- AUTH
# [REQUIRED auth] Google OAuth credentials (Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [REQUIRED auth] Must exactly match the authorized redirect URI in Google Cloud Console.
GOOGLE_AUTH_REDIRECT_URI=
# [REQUIRED auth] Long random string for signing sessions. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ---------------------------------------------------------------- NFL DATA
# [optional] NFL data provider. Default is nflverse (free, no auth required).
NFL_DATA_PROVIDER=nflverse

# -------------------------------------------------------------------- ODDS
# [REQUIRED odds] Live odds provider credentials.
ODDS_API_KEY=
ODDS_API_BASE_URL=

# ---------------------------------------------------------------- INJURIES
# [optional] Injury report provider (phase 5 feature).
INJURY_PROVIDER=
INJURY_API_KEY=

# ----------------------------------------------------------------- WEATHER
# [optional] Weather provider for outdoor games (phase 5 feature).
WEATHER_API_KEY=

# ---------------------------------------------------------------------- AI
# [optional] AI provider for Numby, the AI assistant (phase 7 feature).
AI_PROVIDER=
AI_API_KEY=

# ------------------------------------------------------------------ STRIPE
# [REQUIRED pay] Stripe keys and price IDs (phase 9 subscriptions).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=
# Public base URL of the frontend, used for Stripe Checkout redirects.
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------- AFFILIATE
# Per-sportsbook affiliate configuration lives in the admin/database, NOT in
# environment variables. Only the site-wide disclosure text is env-configurable.
# [optional] Affiliate disclosure shown wherever affiliate links appear.
AFFILIATE_DISCLOSURE_TEXT=

# ------------------------------------------------------------------- ADMIN
# [required for admin endpoints] Shared secret for the X-Admin-Key header
# guarding /api/admin/*. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# --------------------------------------------------------------- ANALYTICS
# [optional] Analytics provider name (e.g. plausible, posthog). Provider-specific
# keys, if any, are configured in the admin/database, not here.
ANALYTICS_PROVIDER=

# ------------------------------------------------------------------ SECURITY
# [optional] "development" (default) or "production". Production refuses to
# boot with a wildcard CORS origin and enables HSTS on every response.
ENVIRONMENT=development
# [required for production] Comma-separated CORS origins, e.g.
# https://moneybynumbers.com,https://www.moneybynumbers.com
CORS_ORIGINS=http://localhost:3000
# [optional] Per-IP per-minute rate limits on abuse-sensitive endpoints.
RATE_LIMIT_NUMBY_PER_MIN=30
RATE_LIMIT_REDIRECT_PER_MIN=60

# ---------------------------------------------------------------- FRONTEND
# [optional] Public API base URL baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --------------------------------------------------------------- SCHEDULER
# [optional] Phase 10 automation. The scheduler needs MONGODB_URI (above);
# it has no in-memory mode because locks and run history must survive
# restarts.
# [optional] Generic JSON webhook (Slack/Discord/PagerDuty) receiving
# scheduler alerts: job failures, crashed runs, missed runs.
ALERT_WEBHOOK_URL=
# [optional] Minutes after which a running lock is considered stale (the
# previous runner is assumed dead; its run is marked "crashed" and the
# lock is reclaimed with an alert). Default: 120.
SCHEDULER_STALE_MINUTES=
